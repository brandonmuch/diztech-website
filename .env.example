# Environment variables for the diztech-website Cloudflare Pages project.
# Set these under Pages project → Settings → Environment variables (and,
# for the two secrets, use "Encrypt" so they're not readable after saving).
# None of these are needed to run `npm run dev` locally — they're only
# used by the Pages Functions in /functions, which only run once deployed
# (or under `wrangler pages dev`, if you set up a local .dev.vars file).

# Public — safe to expose in the browser. Astro inlines this at build time,
# so it must also be set as a *build* environment variable, not just a
# Functions runtime one.
PUBLIC_TURNSTILE_SITE_KEY=

# Server-side — used by /functions/api/contact.js and /functions/api/careers.js
TURNSTILE_SECRET_KEY=
CONTACT_DESTINATION_EMAIL=
CAREERS_DESTINATION_EMAIL=

# Server-side — used by /functions/auth.js and /functions/callback.js
# (the Decap CMS GitHub login handshake). Mark CLIENT_SECRET as a secret.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
