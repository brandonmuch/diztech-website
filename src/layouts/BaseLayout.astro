---
import Header from "../components/global/Header.astro";
import Footer from "../components/global/Footer.astro";
import SkipLink from "../components/global/SkipLink.astro";
import CookieNotice from "../components/global/CookieNotice.astro";
import "../styles/tokens.css";
import "../styles/base.css";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title} | DizTech</title>
    <meta name="description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Lexend:wght@400;500;600;700;800&family=Source+Sans+3:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <script is:inline>
      // Set before paint so no-JS visitors never see a permanently-hidden [data-reveal] section.
      document.documentElement.classList.add("js");
    </script>

    <!-- Netlify Identity invite/confirmation/recovery links redirect to the
         site's Site URL (this homepage, not necessarily /admin) with a
         token in the URL hash - this widget has to be loaded wherever that
         landing page is to catch it and pop the "set your password" modal.
         Without it here, clicking the invite link just lands on a normal
         page with no prompt at all. /admin/index.html loads its own copy
         too, for the actual login screen there. -->
    <script src="https://identity.netlify.com/v1/netlify-identity-widget.js" is:inline></script>
    <script is:inline>
      if (window.netlifyIdentity) {
        window.netlifyIdentity.on("init", (user) => {
          if (!user) {
            window.netlifyIdentity.on("login", () => {
              document.location.href = "/admin/";
            });
          }
        });
      }
    </script>
  </head>
  <body>
    <SkipLink />
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <CookieNotice />
    <script src="../scripts/motion.ts"></script>
  </body>
</html>
