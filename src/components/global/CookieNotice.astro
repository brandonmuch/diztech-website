---
// Lightweight, dismissible disclosure — not a consent-blocking banner.
// The site doesn't set tracking/advertising cookies (see the Privacy
// Policy's Cookies section), so a simple "here's what we use, here's
// where to read more" notice is proportionate rather than a full
// accept/reject gate.
---

<div id="cookie-notice" class="cookie-notice" hidden>
  <div class="cookie-notice__inner">
    <p>
      This site uses a small number of essential cookies (from Cloudflare Turnstile, to keep our forms
      spam-free). We don't use tracking or advertising cookies.
      <button type="button" class="cookie-notice__link" data-open-modal="privacy-policy-modal">
        Read our Privacy Policy
      </button>
    </p>
    <button type="button" class="btn btn--primary cookie-notice__dismiss" data-cookie-dismiss>Got it</button>
  </div>
</div>

<style>
  .cookie-notice {
    position: fixed;
    left: var(--space-4);
    right: var(--space-4);
    bottom: var(--space-4);
    z-index: 60;
    max-width: 640px;
    margin-inline: auto;
    padding: var(--space-4) var(--space-5);
    background: var(--navy);
    color: var(--silver);
    border-radius: var(--radius-md);
    box-shadow: 0 12px 32px -12px rgba(11, 31, 58, 0.5);
  }

  .cookie-notice__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    align-items: flex-start;
  }

  .cookie-notice p {
    font-size: var(--text-sm);
  }

  .cookie-notice__link {
    background: none;
    border: none;
    padding: 0;
    margin-left: var(--space-1);
    color: var(--sky);
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 2px;
    cursor: pointer;
    font-family: inherit;
  }

  .cookie-notice__link:hover,
  .cookie-notice__link:focus-visible {
    color: var(--white);
  }

  .cookie-notice__dismiss {
    align-self: flex-end;
  }

  @media (min-width: 640px) {
    .cookie-notice__inner {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-5);
    }

    .cookie-notice__dismiss {
      align-self: center;
      flex-shrink: 0;
    }
  }
</style>

<script>
  const STORAGE_KEY = "diztech-cookie-notice-dismissed";
  const notice = document.getElementById("cookie-notice");

  if (notice && !localStorage.getItem(STORAGE_KEY)) {
    notice.hidden = false;
  }

  notice?.querySelector("[data-cookie-dismiss]")?.addEventListener("click", () => {
    localStorage.setItem(STORAGE_KEY, "1");
    if (notice) notice.hidden = true;
  });
</script>
