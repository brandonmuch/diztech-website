---
import { getEntry } from "astro:content";

const settingsEntry = await getEntry("siteSettings", "main");
const wordmark = settingsEntry?.data.wordmark ?? "DizTech";

const navItems = [
  { label: "Home", href: "/" },
  { label: "About Us", href: "/#about" },
  { label: "Technology & Services", href: "/technology-services" },
  { label: "Insights", href: "/insights" },
  { label: "Careers", href: "/#careers" },
];
---

<header class="site-header">
  <div class="container site-header__inner">
    <a href="/" class="wordmark">
      <img src="/uploads/diztech-logo.png" alt={wordmark} width="60" height="50" class="wordmark__mark" />
    </a>

    <nav class="site-nav" aria-label="Primary">
      <ul class="site-nav__list">
        {
          navItems.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a href="/#contact" class="btn btn--primary site-header__cta">
      Schedule a Consultation
    </a>

    <button
      class="nav-toggle"
      aria-expanded="false"
      aria-controls="mobile-nav"
      id="nav-toggle"
    >
      <span class="visually-hidden">Menu</span>
      <span class="nav-toggle__bar"></span>
      <span class="nav-toggle__bar"></span>
      <span class="nav-toggle__bar"></span>
    </button>
  </div>

  <div class="mobile-nav" id="mobile-nav" hidden>
    <ul>
      {
        navItems.map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
          </li>
        ))
      }
      <li>
        <a href="/#contact" class="btn btn--primary">Schedule a Consultation</a>
      </li>
    </ul>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--white);
    border-bottom: 1px solid var(--silver);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-3);
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
  }

  .wordmark__mark {
    display: block;
    width: 60px;
    height: 50px;
  }

  .site-nav {
    display: none;
  }

  .site-nav__list {
    display: flex;
    list-style: none;
    gap: var(--space-5);
    padding: 0;
  }

  .site-nav__list a {
    text-decoration: none;
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--charcoal);
    transition: color var(--motion-fast) var(--motion-ease);
  }

  .site-nav__list a:hover,
  .site-nav__list a:focus-visible {
    color: var(--sky-text);
  }

  .site-header__cta {
    display: none;
  }

  .nav-toggle {
    display: flex;
    flex-direction: column;
    gap: 5px;
    padding: var(--space-2);
  }

  .nav-toggle__bar {
    width: 22px;
    height: 2px;
    background: var(--navy);
    transition: transform var(--motion-fast) var(--motion-ease), opacity var(--motion-fast) var(--motion-ease);
  }

  .nav-toggle[aria-expanded="true"] .nav-toggle__bar:nth-child(2) {
    transform: translateY(7px) rotate(45deg);
  }
  .nav-toggle[aria-expanded="true"] .nav-toggle__bar:nth-child(3) {
    opacity: 0;
  }
  .nav-toggle[aria-expanded="true"] .nav-toggle__bar:nth-child(4) {
    transform: translateY(-7px) rotate(-45deg);
  }

  .mobile-nav {
    position: fixed;
    inset: 0;
    top: 73px;
    background: var(--navy);
    z-index: 49;
    padding: var(--space-6) var(--space-4);
  }

  .mobile-nav ul {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .mobile-nav a {
    text-decoration: none;
    color: var(--white);
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 600;
  }

  .mobile-nav .btn {
    display: inline-flex;
    margin-top: var(--space-3);
  }

  @media (min-width: 1024px) {
    .site-nav {
      display: block;
    }

    .site-header__cta {
      display: inline-flex;
    }

    .nav-toggle {
      display: none;
    }
  }
</style>

<script>
  const toggle = document.getElementById("nav-toggle");
  const mobileNav = document.getElementById("mobile-nav");

  toggle?.addEventListener("click", () => {
    const isOpen = toggle.getAttribute("aria-expanded") === "true";
    toggle.setAttribute("aria-expanded", String(!isOpen));
    if (mobileNav) mobileNav.hidden = isOpen;
    document.body.style.overflow = isOpen ? "" : "hidden";
  });

  // Close mobile nav when a link inside it is activated
  mobileNav?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      toggle?.setAttribute("aria-expanded", "false");
      if (mobileNav) mobileNav.hidden = true;
      document.body.style.overflow = "";
    });
  });
</script>
