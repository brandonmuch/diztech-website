---
interface Props {
  eyebrow?: string;
  heading: string;
  description?: string;
  id?: string;
}

const { eyebrow, heading, description, id } = Astro.props;
---

<div class="section-heading" data-reveal>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h2 id={id}>{heading}</h2>
  {description && <p>{description}</p>}
</div>
