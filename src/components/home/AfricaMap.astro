---
import { getCollection } from "astro:content";
import SectionHeading from "../ui/SectionHeading.astro";

const presence = (await getCollection("siteData")).sort(
  (a, b) => a.data.order - b.data.order
);
---

<section class="section section--navy africa-map" id="why-choose-us">
  <div class="container">
    <SectionHeading
      heading="Present across Africa"
      description="From our head office in Zimbabwe, we deliver transformation projects across the continent."
    />

    <div class="africa-map__layout">
      <div class="africa-map__image-wrap" data-reveal>
        <img
          src="/uploads/africa-presence-map.png"
          alt={`Map of Africa with DizTech's presence highlighted across ${presence.length} countries: ${presence.map((p) => p.data.country).join(", ")}`}
          width="1254"
          height="1254"
        />
      </div>

      <ul class="africa-map__legend">
        {
          presence.map((entry) => (
            <li>
              <span class="africa-map__legend-dot" aria-hidden="true" />
              <span>
                <strong>{entry.data.label}</strong>
                {entry.data.isHQ && <span class="africa-map__hq-tag">Head office</span>}
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .africa-map__layout {
    display: grid;
    gap: var(--space-6);
    align-items: center;
  }

  .africa-map__image-wrap img {
    display: block;
    width: 100%;
    height: auto;
    max-width: 480px;
    margin-inline: auto;
  }

  .africa-map__legend {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .africa-map__legend li {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--silver);
  }

  .africa-map__legend-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--sky);
    flex-shrink: 0;
  }

  .africa-map__hq-tag {
    display: block;
    font-size: var(--text-xs);
    color: var(--sky);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  @media (min-width: 1024px) {
    .africa-map__layout {
      grid-template-columns: 3fr 2fr;
    }
  }
</style>
