---
import { getEntry } from "astro:content";
import SectionHeading from "../ui/SectionHeading.astro";

const entry = await getEntry("home", "contact");
const data = entry!.data as {
  heading: string;
  intro: string;
  serviceOptions: string[];
  email: string;
  locationsHeading: string;
  locations: Array<{ name: string; address: string; phone: string }>;
  closingLine: string;
  privacyNote: string;
};
---

<section class="section section--navy contact" id="contact">
  <div class="container">
    <SectionHeading heading={data.heading} description={data.intro} />

    <div class="contact__grid">
      <form
        name="contact"
        method="POST"
        data-netlify="true"
        netlify-honeypot="bot-field"
        class="contact__form"
        data-reveal
        id="contact-form"
      >
        <input type="hidden" name="form-name" value="contact" />
        <p class="visually-hidden">
          <label>Don't fill this out if you're human: <input name="bot-field" /></label>
        </p>

        <div class="contact__field-row">
          <div class="contact__field">
            <label for="firstName">First name *</label>
            <input id="firstName" name="firstName" type="text" required />
          </div>
          <div class="contact__field">
            <label for="lastName">Last name *</label>
            <input id="lastName" name="lastName" type="text" required />
          </div>
        </div>

        <div class="contact__field-row">
          <div class="contact__field">
            <label for="email">Email address *</label>
            <input id="email" name="email" type="email" required />
          </div>
          <div class="contact__field">
            <label for="phone">Phone number *</label>
            <input id="phone" name="phone" type="tel" required />
          </div>
        </div>

        <div class="contact__field-row">
          <div class="contact__field">
            <label for="company">Company</label>
            <input id="company" name="company" type="text" />
          </div>
          <div class="contact__field">
            <label for="role">Job title / role</label>
            <input id="role" name="role" type="text" />
          </div>
        </div>

        <div class="contact__field">
          <label for="serviceInterest">Service interest</label>
          <select id="serviceInterest" name="serviceInterest">
            {data.serviceOptions.map((option) => <option value={option}>{option}</option>)}
          </select>
        </div>

        <div class="contact__field">
          <label for="message">How would you want us to help you?</label>
          <textarea id="message" name="message" rows="4"></textarea>
        </div>

        <div data-netlify-recaptcha="true"></div>

        <button type="submit" class="btn btn--primary contact__submit">Schedule a Consultation</button>

        <p class="contact__privacy">{data.privacyNote}</p>
      </form>

      <div class="contact__locations" data-reveal>
        <p class="contact__email">
          <a href={`mailto:${data.email}`}>{data.email}</a>
        </p>
        <h3>{data.locationsHeading}</h3>
        {
          data.locations.map((loc) => (
            <div class="contact__location">
              <p class="contact__location-name">{loc.name}</p>
              <p>{loc.address}</p>
              <p><a href={`tel:${loc.phone.replace(/\s+/g, "")}`}>{loc.phone}</a></p>
            </div>
          ))
        }
        <p class="contact__closing">{data.closingLine}</p>
      </div>
    </div>
  </div>
</section>

<!-- Success Popup -->
<div id="success-popup" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.6); z-index: 1000; align-items: center; justify-content: center;">
  <div style="background: white; padding: 2.5rem; border-radius: 8px; max-width: 480px; width: 90%; position: relative; text-align: center;">
    <button id="popup-close-x" style="position: absolute; top: 12px; right: 12px; background: none; border: none; font-size: 28px; cursor: pointer; color: #666; line-height: 1;">&times;</button>
    <h3 style="color: #0b1f3a; margin-bottom: 1rem; font-size: 1.5rem;">Thank You!</h3>
    <p style="color: #333; margin-bottom: 1.5rem; line-height: 1.6;">Your message has been sent successfully. Our team will get back to you shortly.</p>
    <button id="popup-close-btn" style="background: #0aa8db; color: white; padding: 0.75rem 2rem; border: none; border-radius: 4px; font-weight: 600; cursor: pointer; font-size: 1rem;">Close</button>
  </div>
</div>

<script>
  function closePopup() {
    document.getElementById('success-popup').style.display = 'none';
  }

  const form = document.getElementById('contact-form');
  const popupCloseX = document.getElementById('popup-close-x');
  const popupCloseBtn = document.getElementById('popup-close-btn');
  const successPopup = document.getElementById('success-popup');

  // Close popup with X button
  popupCloseX?.addEventListener('click', closePopup);
  
  // Close popup with Close button
  popupCloseBtn?.addEventListener('click', closePopup);

  // Close popup when clicking outside
  successPopup?.addEventListener('click', (e) => {
    if (e.target === successPopup) {
      closePopup();
    }
  });

  // Close popup with Escape key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      closePopup();
    }
  });

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    
    const formData = new FormData(form);
    
    fetch('/', {
      method: 'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body: new URLSearchParams(formData).toString(),
    })
    .then(() => {
      successPopup.style.display = 'flex';
      form.reset();
    })
    .catch(() => {
      alert('Something went wrong. Please try again or email us directly.');
    });
  });
</script>

<style>
  .contact__grid {
    display: grid;
    gap: var(--space-6);
  }

  .contact__form {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .contact__submit {
    align-self: flex-start;
  }

  .contact__field-row {
    display: grid;
    gap: var(--space-4);
  }

  .contact__field {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .contact__field label {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--white);
  }

  .contact__field input,
  .contact__field select,
  .contact__field textarea {
    padding: var(--space-3);
    border: 1px solid var(--silver);
    border-radius: var(--radius-sm);
    background: var(--white);
    color: var(--charcoal);
  }

  .contact__field input:focus-visible,
  .contact__field select:focus-visible,
  .contact__field textarea:focus-visible {
    outline: 2px solid var(--sky-text);
    outline-offset: 1px;
  }

  .contact__privacy {
    font-size: var(--text-xs);
    color: var(--silver);
  }

  .contact__email {
    margin-bottom: var(--space-5);
  }

  .contact__email a {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--sky);
    text-decoration: none;
  }

  .contact__email a:hover,
  .contact__email a:focus-visible {
    text-decoration: underline;
  }

  .contact__locations h3 {
    font-size: var(--text-lg);
    color: var(--white);
    margin-bottom: var(--space-4);
  }

  .contact__location {
    padding: var(--space-4);
    background: var(--white);
    border-radius: var(--radius-md);
    margin-bottom: var(--space-3);
  }

  .contact__location-name {
    font-weight: 700;
    color: var(--navy);
  }

  .contact__location p {
    color: var(--navy);
  }

  .contact__location a {
    color: var(--sky-text);
    text-decoration: none;
  }

  .contact__closing {
    margin-top: var(--space-4);
    font-family: var(--font-display);
    font-size: var(--text-md);
    font-weight: 600;
    color: var(--sky);
    font-style: italic;
  }

  @media (min-width: 640px) {
    .contact__field-row {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 1024px) {
    .contact__grid {
      grid-template-columns: 3fr 2fr;
    }
  }
</style>