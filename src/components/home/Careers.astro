---
import { getEntry } from "astro:content";
import SectionHeading from "../ui/SectionHeading.astro";

const entry = await getEntry("home", "careers");
const data = entry!.data as {
  eyebrow: string;
  heading: string;
  subtext: string;
  whyWorkWithUs: Array<{ title: string; description: string }>;
  openings: Array<{ title: string; description: string }>;
  howToApply: string;
  applyAnywayNote: string;
  dataProtectionNote: string;
  closingLine: string;
};

const hasOpenings = data.openings.length > 0;
---

<section class="section section--navy careers" id="careers">
  <div class="container">
    <SectionHeading eyebrow={data.eyebrow} heading={data.heading} description={data.subtext} />

    <div class="careers__grid">
      <div class="careers__why" data-reveal>
        <h3>Why work with us</h3>
        <ul>
          {
            data.whyWorkWithUs.map((item) => (
              <li>
                <strong>{item.title}.</strong> {item.description}
              </li>
            ))
          }
        </ul>
      </div>

      <div class="careers__openings" data-reveal>
        <h3>Current openings</h3>
        <ul>
          {
            data.openings.map((role) => (
              <li>
                <strong>{role.title}</strong>
                <span>{role.description}</span>
              </li>
            ))
          }
        </ul>

        <h3>How to apply</h3>
        <p>{data.howToApply}</p>
        <p class="careers__apply-anyway">{data.applyAnywayNote}</p>
        <p class="careers__closing">{data.closingLine}</p>
      </div>
    </div>

    <div class="careers__form-wrap" data-reveal>
      <h3>Apply now</h3>

      <form
        name="careers-application"
        method="POST"
        data-netlify="true"
        netlify-honeypot="bot-field"
        enctype="multipart/form-data"
        class="careers__form"
        id="careers-form"
      >
        <input type="hidden" name="form-name" value="careers-application" />
        <p class="visually-hidden">
          <label>Don't fill this out if you're human: <input name="bot-field" /></label>
        </p>

        <div class="careers__field-row">
          <div class="careers__field">
            <label for="firstName">First name *</label>
            <input id="firstName" name="firstName" type="text" required />
          </div>
          <div class="careers__field">
            <label for="lastName">Last name *</label>
            <input id="lastName" name="lastName" type="text" required />
          </div>
        </div>

        <div class="careers__field-row">
          <div class="careers__field">
            <label for="careersEmail">Email address *</label>
            <input id="careersEmail" name="email" type="email" required />
          </div>
          <div class="careers__field">
            <label for="careersPhone">Phone number *</label>
            <input id="careersPhone" name="phone" type="tel" required />
          </div>
        </div>

        <div class="careers__field">
          <label for="position">Position applying for</label>
          {
            hasOpenings ? (
              <select id="position" name="position">
                {data.openings.map((role) => <option value={role.title}>{role.title}</option>)}
                <option value="General application">General application (no listed role fits)</option>
              </select>
            ) : (
              <select id="position" name="position">
                <option value="General application" selected>
                  Roles currently unavailable — general application
                </option>
              </select>
            )
          }
        </div>

        <div class="careers__field">
          <label for="cv">Upload CV / résumé *</label>
          <input id="cv" name="cv" type="file" required accept=".pdf,.doc,.docx" />
        </div>

        <div class="careers__field">
          <label for="message">Anything else you'd like us to know? (optional)</label>
          <textarea id="message" name="message" rows="3"></textarea>
        </div>

        <p class="careers__data-note">{data.dataProtectionNote}</p>

        <label class="careers__consent">
          <input type="checkbox" name="consent" required />
          I consent to DizTech ERP Solutions storing and processing my personal data for recruitment purposes.
        </label>

        <div data-netlify-recaptcha="true"></div>

        <button type="submit" class="btn btn--primary careers__submit">Apply Now</button>
      </form>
    </div>
  </div>
</section>

<!-- Success Popup -->
<div id="careers-success-popup" onclick="this.style.display='none'" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.6); z-index: 1000; align-items: center; justify-content: center; cursor: pointer;">
  <div onclick="event.stopPropagation()" style="background: white; padding: 2.5rem; border-radius: 8px; max-width: 480px; width: 90%; position: relative; text-align: center; cursor: default;">
    <h3 style="color: #0b1f3a; margin-bottom: 1rem; font-size: 1.5rem;">Application Submitted!</h3>
    <p style="color: #333; margin-bottom: 1.5rem; line-height: 1.6;">Thank you for your interest in joining DizTech ERP Solutions. We've received your application and will be in touch if there's a match.</p>
    <p style="color: #999; font-size: 0.875rem;">This message will close automatically</p>
  </div>
</div>

<script>
  const careersForm = document.getElementById('careers-form');
  const careersSuccessPopup = document.getElementById('careers-success-popup');
  let careersAutoCloseTimer;

  function showCareersPopup() {
    careersSuccessPopup.style.display = 'flex';
    careersSuccessPopup.style.opacity = '1';
    
    // Auto close after 5 seconds
    careersAutoCloseTimer = setTimeout(() => {
      careersSuccessPopup.style.opacity = '0';
      setTimeout(() => {
        careersSuccessPopup.style.display = 'none';
      }, 300);
    }, 5000);
  }

  // Close immediately when clicking anywhere on the popup
  careersSuccessPopup?.addEventListener('click', () => {
    clearTimeout(careersAutoCloseTimer);
    careersSuccessPopup.style.display = 'none';
  });

  careersForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    
    const formData = new FormData(careersForm);
    
    fetch('/', {
      method: 'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body: new URLSearchParams(formData).toString(),
    })
    .then(() => {
      showCareersPopup();
      careersForm.reset();
    })
    .catch(() => {
      alert('Something went wrong. Please try again or email us directly at info@diztech.co.zw');
    });
  });
</script>

<style>
  .careers h3 {
    font-size: var(--text-lg);
    color: var(--white);
    margin-bottom: var(--space-3);
  }

  .careers__grid {
    display: grid;
    gap: var(--space-6);
    margin-top: var(--space-7);
  }

  .careers ul {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .careers__why li,
  .careers__openings p {
    color: var(--silver);
    font-size: var(--text-sm);
  }

  .careers__openings li {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    color: var(--silver);
    font-size: var(--text-sm);
  }

  .careers__openings li strong {
    color: var(--white);
  }

  .careers__openings h3:not(:first-child) {
    margin-top: var(--space-5);
  }

  .careers__apply-anyway {
    margin-top: var(--space-2);
    font-weight: 600;
    color: var(--sky);
  }

  .careers__closing {
    margin-top: var(--space-3);
    color: var(--sky);
    font-style: italic;
  }

  .careers__form-wrap {
    margin-top: var(--space-8);
    padding-top: var(--space-7);
    border-top: 1px solid rgba(255, 255, 255, 0.15);
  }

  .careers__form {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    max-width: 560px;
  }

  .careers__field-row {
    display: grid;
    gap: var(--space-4);
  }

  .careers__field {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .careers__field label {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--white);
  }

  .careers__field input,
  .careers__field select,
  .careers__field textarea {
    padding: var(--space-3);
    border: 1px solid var(--silver);
    border-radius: var(--radius-sm);
    background: var(--white);
    color: var(--charcoal);
    font-family: inherit;
  }

  .careers__field input[type="file"] {
    padding: var(--space-2);
  }

  .careers__field input:focus-visible,
  .careers__field select:focus-visible,
  .careers__field textarea:focus-visible {
    outline: 2px solid var(--sky-text);
    outline-offset: 1px;
  }

  .careers__data-note {
    font-size: var(--text-xs);
    color: var(--silver);
  }

  .careers__consent {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--silver);
  }

  .careers__consent input {
    margin-top: 3px;
    width: auto;
  }

  .careers__submit {
    align-self: flex-start;
  }

  @media (min-width: 640px) {
    .careers__field-row {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 1024px) {
    .careers__grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>