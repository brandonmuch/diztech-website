---
import { getEntry } from "astro:content";
import SectionHeading from "../ui/SectionHeading.astro";
import TonalPlaceholder from "../ui/TonalPlaceholder.astro";
import { toParagraphs } from "../../lib/renderText";

const entry = await getEntry("home", "about");
const data = entry!.data as {
  heading: string;
  body: string;
  visionHeading: string;
  vision: string;
  image?: string;
  imageAlt: string;
};

const paragraphs = toParagraphs(data.body);
---

<section class="section about" id="about">
  <div class="container about__grid">
    <div class="about__text">
      <SectionHeading heading={data.heading} />
      {paragraphs.map((p) => <p class="about__paragraph">{p}</p>)}

      <div class="about__vision" data-reveal>
        <p class="about__vision-label">{data.visionHeading}</p>
        <p class="about__vision-text">{data.vision}</p>
      </div>
    </div>

    <div class="about__media" data-reveal>
      {
        data.image ? (
          <img src={data.image} alt={data.imageAlt} />
        ) : (
          <TonalPlaceholder alt={data.imageAlt} variant="abyssal" />
        )
      }
    </div>
  </div>
</section>

<style>
  .about__grid {
    display: grid;
    gap: var(--space-6);
  }

  .about__paragraph {
    margin-top: var(--space-3);
    max-width: 60ch;
  }

  .about__vision {
    margin-top: var(--space-5);
    padding: var(--space-5);
    background: var(--navy);
    border-radius: var(--radius-md);
  }

  .about__vision-label {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--sky);
  }

  .about__vision-text {
    margin-top: var(--space-2);
    font-family: var(--font-display);
    font-size: var(--text-md);
    font-weight: 600;
    color: var(--white);
  }

  .about__media {
    aspect-ratio: 4 / 3;
  }

  .about__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--radius-md);
  }

  /* The heading is a long line ("DizTech | Your trusted ERP integration and
     business consultancy partner") — at the shared .section-heading h2 size
     it wraps to 4-5 short, unevenly "stacked" lines on tablet/desktop. Give
     it more room and a size suited to that length, without touching mobile,
     where the default full-width single-column layout already wraps fine. */
  @media (min-width: 640px) {
    /* .section-heading's global max-width: 46ch is sized against the
       wrapper's own (body-sized) font, not the much larger heading font —
       for most section titles that's still generous, but this one is an
       unusually long compound heading and 46ch caps it to ~366px regardless
       of how wide the column actually is. Let it use the full column. */
    .about__text :global(.section-heading) {
      max-width: none;
    }

    .about__text :global(.section-heading h2) {
      font-size: var(--text-2xl);
      text-wrap: pretty;
    }
  }

  @media (min-width: 1024px) {
    .about__grid {
      grid-template-columns: 2fr 1fr;
      align-items: start;
    }
  }
</style>
