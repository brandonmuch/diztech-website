---
import { wordCount } from "../../lib/renderText";

interface Props {
  summary: string;
  bullets: string[];
  id: string;
  threshold?: number;
}

const { summary, bullets, id, threshold = 60 } = Astro.props;
const needsReveal = wordCount(bullets.join(" ")) > threshold;
---

<div class="read-more">
  <p class="read-more__summary">{summary}</p>

  {
    needsReveal ? (
      <>
        <button
          type="button"
          class="read-more__trigger"
          aria-expanded="false"
          aria-controls={`${id}-full`}
        >
          Read more
        </button>
        <ul class="read-more__full" id={`${id}-full`}>
          {bullets.map((b) => <li>{b}</li>)}
        </ul>
      </>
    ) : (
      <ul class="read-more__full read-more__full--static">
        {bullets.map((b) => <li>{b}</li>)}
      </ul>
    )
  }
</div>

<style>
  .read-more__summary {
    font-weight: 500;
  }

  .read-more__full {
    margin-top: var(--space-3);
    padding-left: var(--space-5);
  }

  .read-more__full li {
    margin-top: var(--space-2);
  }

  .read-more__full li::marker {
    color: var(--sky-text);
  }

  .read-more__trigger {
    margin-top: var(--space-3);
    color: var(--sky-text);
    font-weight: 600;
    font-size: var(--text-sm);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .read-more__trigger:hover,
  .read-more__trigger:focus-visible {
    color: var(--navy);
  }
</style>

<script>
  // Full content is server-rendered and visible by default (no-JS baseline).
  // Once JS confirms it can run, collapse it behind the "Read more" trigger.
  document.querySelectorAll<HTMLButtonElement>(".read-more__trigger").forEach((btn) => {
    const fullId = btn.getAttribute("aria-controls");
    if (!fullId) return;
    const full = document.getElementById(fullId);
    if (!full) return;

    full.hidden = true;

    btn.addEventListener("click", () => {
      const isOpen = btn.getAttribute("aria-expanded") === "true";
      btn.setAttribute("aria-expanded", String(!isOpen));
      full.hidden = isOpen;
      btn.textContent = isOpen ? "Read more" : "Show less";
    });
  });
</script>
