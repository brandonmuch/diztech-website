---
import ReadMoreReveal from "./ReadMoreReveal.astro";

interface Props {
  id: string;
  title: string;
  summary?: string;
  bullets?: string[];
  open?: boolean;
  wide?: boolean;
}

const { id, title, summary, bullets, open = false, wide = false } = Astro.props;
---

<details class="accordion-section" id={id} open={open}>
  <summary class="accordion-trigger">
    <h3>{title}</h3>
    <svg class="accordion-trigger__chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="m6 9 6 6 6-6" />
    </svg>
  </summary>
  <div class:list={["accordion-content", { "accordion-content--wide": wide }]}>
    {summary && bullets ? <ReadMoreReveal summary={summary} bullets={bullets} id={id} /> : <slot />}
  </div>
</details>

<style>
  .accordion-section {
    border-bottom: 1px solid var(--silver);
  }

  .accordion-trigger {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding-block: var(--space-4);
    list-style: none;
  }

  .accordion-trigger::-webkit-details-marker {
    display: none;
  }

  .accordion-trigger h3 {
    font-size: var(--text-md);
    color: var(--navy);
  }

  .accordion-trigger__chevron {
    width: 20px;
    height: 20px;
    color: var(--sky-text);
    flex-shrink: 0;
    transition: transform var(--motion-fast) var(--motion-ease);
  }

  .accordion-section[open] .accordion-trigger__chevron {
    transform: rotate(180deg);
  }

  .accordion-content {
    padding-bottom: var(--space-5);
    color: var(--charcoal);
  }

  @media (min-width: 640px) {
    .accordion-content:not(.accordion-content--wide) {
      max-width: 68%;
    }
  }

  .accordion-content--wide {
    max-width: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .accordion-trigger__chevron {
      transition: none;
    }
  }
</style>
