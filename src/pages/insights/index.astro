---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import CategoryFilter from "../../components/insights/CategoryFilter.astro";
import FeaturedArticleCard from "../../components/insights/FeaturedArticleCard.astro";
import ArticleGrid from "../../components/insights/ArticleGrid.astro";
import ArticleModal from "../../components/insights/ArticleModal.astro";

const allArticles = (await getCollection("insights")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const featured = allArticles.find((a) => a.data.featured) ?? allArticles[0];
const latest = allArticles.filter((a) => a.id !== featured.id);

const categories = [
  "SAP",
  "S/4HANA",
  "SuccessFactors",
  "Public Finance",
  "Digital Transformation",
  "ERP Implementation",
  "Project Management",
  "Change Management",
  "Business Advisory",
];
---

<BaseLayout
  title="Insights"
  description="Insights and resources on SAP, ERP implementation, project management, and digital transformation across Africa, from DizTech."
>
  <section class="section section--navy insights-hero">
    <div class="container">
      <h1>Thinking that moves African institutions forward</h1>
      <p class="insights-hero__intro">
        Practical perspectives on ERP implementation, project management, and digital
        transformation, drawn from two decades of advisory experience across the continent.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <CategoryFilter categories={categories} />

      <div data-reveal>
        <FeaturedArticleCard article={featured} />
      </div>

      <div class="insights-latest">
        <h2>Latest articles</h2>
        <ArticleGrid articles={latest} />
      </div>
    </div>
  </section>

  {allArticles.map((article) => <ArticleModal article={article} />)}
</BaseLayout>

<script>
  document.addEventListener("click", (event) => {
    const target = event.target as HTMLElement;

    const trigger = target.closest<HTMLElement>("[data-open-modal]");
    if (trigger) {
      const modal = document.getElementById(trigger.dataset.openModal!);
      if (modal instanceof HTMLDialogElement) modal.showModal();
      return;
    }

    const closer = target.closest<HTMLElement>("[data-close-modal]");
    if (closer) {
      closer.closest("dialog")?.close();
      return;
    }
  });

  // Card triggers are role="button" divs (real headings live inside them,
  // which a native <button> can't legally contain) — Enter/Space activation
  // has to be wired up by hand since the browser only does that for free
  // on real form controls.
  document.addEventListener("keydown", (event) => {
    if (event.key !== "Enter" && event.key !== " ") return;
    const target = event.target as HTMLElement;
    if (!target.matches('[data-open-modal][role="button"]')) return;

    event.preventDefault();
    const modal = document.getElementById(target.dataset.openModal!);
    if (modal instanceof HTMLDialogElement) modal.showModal();
  });

  // Click on the backdrop (the dialog element itself, outside its content box) closes it.
  document.querySelectorAll<HTMLDialogElement>(".article-modal").forEach((dialog) => {
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });
  });
</script>

<style>
  .insights-hero h1 {
    font-size: var(--text-3xl);
    color: var(--white);
    max-width: 22ch;
    margin-top: var(--space-3);
  }

  .insights-hero__intro {
    margin-top: var(--space-4);
    color: var(--silver);
    font-size: var(--text-md);
  }

  @media (min-width: 640px) {
    .insights-hero__intro {
      max-width: 68%;
    }
  }

  .insights-latest {
    margin-top: var(--space-8);
  }

  .insights-latest h2 {
    font-size: var(--text-2xl);
    color: var(--navy);
    margin-bottom: var(--space-5);
  }

  @media (min-width: 768px) {
    .insights-hero h1 {
      font-size: var(--text-4xl);
    }
  }
</style>
