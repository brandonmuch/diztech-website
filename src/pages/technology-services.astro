---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ServiceAccordion from "../components/services/ServiceAccordion.astro";

const services = (await getCollection("services")).sort(
  (a, b) => a.data.order - b.data.order
);
---

<BaseLayout
  title="Technology & Services"
  description="SAP S/4HANA, SuccessFactors, public finance management, training, support, business advisory, project management, change management, and quality assurance — from DizTech."
>
  <section class="tech-hero section section--navy">
    <div class="container">
      <p class="eyebrow">Technology &amp; services</p>
      <h1>Technology built for Africa's most serious institutions</h1>
      <p class="tech-hero__intro">
        From SAP implementation to business advisory, we deliver the full depth of
        ERP transformation, backed by two decades of senior advisory experience.
      </p>
    </div>
  </section>

  <nav class="service-nav" aria-label="Jump to a service">
    <ul class="service-nav__list">
      {
        services.map((service) => (
          <li>
            <a href={`#${service.id}`}>{service.data.title}</a>
          </li>
        ))
      }
    </ul>
  </nav>

  <div class="container tech-services__list">
    {
      services.map((service, index) => (
        <ServiceAccordion service={service} allServices={services} index={index} />
      ))
    }
  </div>
</BaseLayout>

<style>
  .tech-hero h1 {
    font-size: var(--text-3xl);
    color: var(--white);
    max-width: 24ch;
    margin-top: var(--space-3);
  }

  .tech-hero__intro {
    margin-top: var(--space-4);
    color: var(--silver);
    font-size: var(--text-md);
  }

  @media (min-width: 640px) {
    .tech-hero__intro {
      max-width: 68%;
    }
  }

  @media (min-width: 768px) {
    .tech-hero h1 {
      font-size: var(--text-4xl);
    }
  }

  .service-nav {
    position: sticky;
    /* Must match the site header's actual rendered height (measured 83px at
       both mobile and desktop — the header stays a single row at every
       breakpoint), otherwise the nav sticks partly underneath the header. */
    top: 83px;
    z-index: 40;
    background: var(--white);
    border-bottom: 1px solid var(--silver);
    /* Mobile: horizontal swipe, same as any filter/chip row there — wrapping
       all 9 pills ate ~40% of the viewport height before any real content
       showed. Fades the trailing edge as a scroll hint. */
    -webkit-mask-image: linear-gradient(90deg, #000 92%, transparent);
    mask-image: linear-gradient(90deg, #000 92%, transparent);
  }

  .service-nav__list {
    display: flex;
    flex-wrap: nowrap;
    overflow-x: auto;
    scrollbar-width: none;
    gap: var(--space-2);
    list-style: none;
    padding: var(--space-3) var(--space-4);
    max-width: var(--max-width);
    margin-inline: auto;
  }

  .service-nav__list::-webkit-scrollbar {
    display: none;
  }

  @media (min-width: 640px) {
    .service-nav {
      -webkit-mask-image: none;
      mask-image: none;
    }

    .service-nav__list {
      flex-wrap: wrap;
      overflow-x: visible;
    }
  }

  .service-nav__list a {
    display: inline-block;
    padding: var(--space-2) var(--space-3);
    border-radius: 999px;
    background: var(--silver-soft);
    color: var(--navy);
    text-decoration: none;
    font-size: var(--text-sm);
    font-weight: 600;
    white-space: nowrap;
    transition: background-color var(--motion-fast) var(--motion-ease);
  }

  .service-nav__list a:hover,
  .service-nav__list a:focus-visible {
    background: var(--sky);
  }

  @media (min-width: 1024px) {
    .service-nav__list {
      padding-inline: var(--space-6);
    }
  }
</style>
